rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Candlestick Master: Security Rules
    // =========================================================================
    // Strict UID-scoped data ownership for user profiles, learning analytics,
    // quiz/challenge attempts, and Trading Journal entries.
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // 1. Root user profile document
      allow read, write: if isOwner(userId);

      // 2. Aggregated Statistics (stats/learning, stats/trading, stats/activity)
      match /stats/{statDoc} {
        allow read, write: if isOwner(userId);
      }

      // 3. Pattern Progress (patternProgress/{patternId})
      match /patternProgress/{patternId} {
        allow read, write: if isOwner(userId);
      }

      // 4. Indicator Progress (indicatorProgress/{indicatorId})
      match /indicatorProgress/{indicatorId} {
        allow read, write: if isOwner(userId);
      }

      // 5. Quiz Attempts (quizAttempts/{attemptId})
      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      // 6. Challenge Attempts (challengeAttempts/{attemptId})
      match /challengeAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      // 7. Trading Journal Records (trades/{tradeId})
      match /trades/{tradeId} {
        allow read, write: if isOwner(userId);
      }

      // 8. Backward-Compatible Trading Journal Mirror (journal/{tradeId})
      match /journal/{tradeId} {
        allow read, write: if isOwner(userId);
      }

      // 9. Backward-Compatible User Progress Document (data/progress)
      match /data/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // 10. Fallback for any other user-owned subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny rule for any collection not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
