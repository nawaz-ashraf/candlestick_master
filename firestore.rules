rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Account Isolation Rules: Candlestick Master
    // =========================================================================
    // Every user's private data is strictly partitioned by their authenticated UID.
    // User A can NEVER read, create, update, or delete records belonging to User B.
    // =========================================================================

    match /users/{userId} {
      // Direct access to user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User gamification progress document
      match /data/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Trading Journal entries
      match /journal/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any additional user subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny rule for any collection not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
