    <!--
        Facebook App ID
        Example: 1234567890123456
        Found at: developers.facebook.com > Your App > Dashboard > App ID
    -->
    <string name="facebook_app_id">845527258581886</string>

    <!--
        Facebook Client Token
        Example: abcdef1234567890abcdef1234567890
        Found at: developers.facebook.com > Your App > Settings > Advanced > Client Token
